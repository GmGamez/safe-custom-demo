{
  "id": "review-decision",
  "type": "default",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "components": [
    {
      "type": "text",
      "id": "text_header",
      "text": "## Review"
    },
    {
      "type": "textfield",
      "id": "tf_useCaseName",
      "label": "Use Case",
      "key": "useCaseName",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "textfield",
      "id": "tf_aiCategory",
      "label": "AI Category",
      "key": "aiCategory",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "textarea",
      "id": "ta_description",
      "label": "Description",
      "key": "description",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "separator",
      "id": "sep_triage"
    },
    {
      "type": "text",
      "id": "text_triage_header",
      "text": "### AI Triage Summary\nGathered by the risk triage agent before this task was created. Advisory only — your independent decision is the governance record."
    },
    {
      "type": "textarea",
      "id": "ta_triageSummary",
      "label": "Triage Summary",
      "key": "triageSummary",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "separator",
      "id": "sep_1"
    },
    {
      "type": "select",
      "id": "select_reviewDecision",
      "label": "Decision",
      "key": "reviewDecision",
      "validate": { "required": true },
      "values": [
        { "label": "Approve", "value": "approve" },
        { "label": "Reject", "value": "reject" }
      ]
    },
    {
      "type": "textarea",
      "id": "ta_reviewComments",
      "label": "Comments",
      "key": "reviewComments"
    }
  ]
}