{
  "id": "decommission",
  "type": "default",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "components": [
    {
      "type": "text",
      "id": "text_header",
      "text": "## Decommission System"
    },
    {
      "type": "textfield",
      "id": "tf_useCaseName",
      "label": "Use Case",
      "key": "useCaseName",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "separator",
      "id": "sep_1"
    },
    {
      "type": "textarea",
      "id": "ta_decommissionReason",
      "label": "Reason",
      "key": "decommissionReason",
      "validate": { "required": true }
    },
    {
      "type": "textfield",
      "id": "tf_decommissionedBy",
      "label": "Decommissioned By (email)",
      "key": "decommissionedBy",
      "validate": { "required": true }
    },
    {
      "type": "checkbox",
      "id": "cb_accessRevoked",
      "label": "Access has been revoked for all users/devices",
      "key": "accessRevoked",
      "validate": { "required": true }
    }
  ]
}