{
  "id": "reassessment-review",
  "type": "default",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "components": [
    {
      "type": "text",
      "id": "text_header",
      "text": "## Reassessment Review"
    },
    {
      "type": "text",
      "id": "text_reason",
      "text": "Triggered by a reported material change or incident for this use case."
    },
    {
      "type": "textfield",
      "id": "tf_useCaseName",
      "label": "Use Case",
      "key": "useCaseName",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "textfield",
      "id": "tf_aiCategory",
      "label": "AI Category",
      "key": "aiCategory",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "separator",
      "id": "sep_1"
    },
    {
      "type": "select",
      "id": "select_reassessmentOutcome",
      "label": "Outcome",
      "key": "reassessmentOutcome",
      "validate": { "required": true },
      "values": [
        { "label": "No material impact — resume monitoring", "value": "no_material_impact" },
        { "label": "Requires full re-review", "value": "requires_full_rereview" },
        { "label": "Recommend decommission", "value": "recommend_decommission" }
      ]
    },
    {
      "type": "textarea",
      "id": "ta_reassessmentNotes",
      "label": "Notes",
      "key": "reassessmentNotes"
    }
  ]
}