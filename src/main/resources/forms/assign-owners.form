{
  "id": "assign-owners",
  "type": "default",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "components": [
    {
      "type": "text",
      "id": "text_header",
      "text": "## Assign Accountable Owners"
    },
    {
      "type": "textfield",
      "id": "tf_useCaseName",
      "label": "Use Case",
      "key": "useCaseName",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "textfield",
      "id": "tf_submittedBy",
      "label": "Submitted By",
      "key": "submittedBy",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "separator",
      "id": "sep_1"
    },
    {
      "type": "textfield",
      "id": "tf_businessOwner",
      "label": "Business Owner (email)",
      "key": "businessOwner",
      "validate": { "required": true }
    },
    {
      "type": "textfield",
      "id": "tf_technologyOwner",
      "label": "Technology Owner (email)",
      "key": "technologyOwner",
      "validate": { "required": true }
    }
  ]
}