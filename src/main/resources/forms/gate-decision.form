{
  "id": "gate-decision",
  "type": "default",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "components": [
    {
      "type": "text",
      "id": "text_header",
      "text": "## Gate Checkpoint"
    },
    {
      "type": "textfield",
      "id": "tf_useCaseName",
      "label": "Use Case",
      "key": "useCaseName",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "textfield",
      "id": "tf_aiCategory",
      "label": "AI Category",
      "key": "aiCategory",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "separator",
      "id": "sep_1"
    },
    {
      "type": "select",
      "id": "select_gateResult",
      "label": "Result",
      "key": "gateResult",
      "validate": { "required": true },
      "values": [
        { "label": "Pass", "value": "pass" },
        { "label": "Fail", "value": "fail" }
      ]
    },
    {
      "type": "textarea",
      "id": "ta_gateNotes",
      "label": "Notes",
      "key": "gateNotes"
    }
  ]
}