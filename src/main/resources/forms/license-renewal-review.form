{
  "id": "license-renewal-review",
  "type": "default",
  "schemaVersion": 18,
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.9.0",
  "components": [
    {
      "type": "text",
      "id": "text_header",
      "text": "## License Renewal Review\nComplete whichever sections apply to your role. Unused sections will be blank."
    },

    {
      "type": "separator",
      "id": "sep_app"
    },
    {
      "type": "text",
      "id": "text_app_section",
      "text": "### Application Details"
    },
    {
      "type": "textfield",
      "id": "tf_appName",
      "label": "Application",
      "key": "appName",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "textfield",
      "id": "tf_vendor",
      "label": "Vendor",
      "key": "vendor",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "textfield",
      "id": "tf_appOwner",
      "label": "App Owner",
      "key": "appOwner",
      "readonly": true,
      "disabled": true
    },
    {
      "type": "number",
      "id": "num_requestedSeats",
      "label": "Current Contracted Seats",
      "key": "requestedSeats",
      "readonly": true,
      "disabled": true
    },

    {
      "type": "separator",
      "id": "sep_usage"
    },
    {
      "type": "text",
      "id": "text_usage_section",
      "text": "### Usage Analysis"
    },
    {
      "type": "expression",
      "id": "expr_resolvedActive",
      "label": "Resolved Active Users",
      "key": "resolvedActiveUsers",
      "expression": "=if usageSummary != null then string(usageSummary.resolvedActiveUsers) else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_oktaActive",
      "label": "Okta SSO — Active Users",
      "key": "oktaActiveDisplay",
      "expression": "=if usageSummary != null then string(usageSummary.oktaActive) else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_flexeraActive",
      "label": "Flexera — Active Devices",
      "key": "flexeraActiveDisplay",
      "expression": "=if usageSummary != null then string(usageSummary.flexeraActive) else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_conflict",
      "label": "Signal Conflict Detected",
      "key": "conflictDisplay",
      "expression": "=if usageSummary != null then (if usageSummary.conflictDetected then \"YES — requires human review\" else \"No\") else \"—\"",
      "readonly": true
    },

    {
      "type": "separator",
      "id": "sep_score"
    },
    {
      "type": "text",
      "id": "text_score_section",
      "text": "### AI-Assisted Decision Score"
    },
    {
      "type": "expression",
      "id": "expr_recommendation",
      "label": "Recommendation",
      "key": "recommendationDisplay",
      "expression": "=if usageScore != null then usageScore.recommendation else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_utilizationBand",
      "label": "Utilization Band",
      "key": "utilizationBandDisplay",
      "expression": "=if usageScore != null then usageScore.utilizationBand else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_reclaimableCount",
      "label": "Licenses Proposed for Reclamation",
      "key": "reclaimableCountDisplay",
      "expression": "=if reclaimableCount != null then string(reclaimableCount) else \"0\"",
      "readonly": true
    },

    {
      "type": "separator",
      "id": "sep_owner_decision"
    },
    {
      "type": "text",
      "id": "text_owner_decision",
      "text": "### App Owner: Reclamation Decision"
    },
    {
      "type": "select",
      "id": "select_reviewDecision",
      "label": "Review Decision",
      "key": "reviewDecision",
      "values": [
        { "label": "Approve — proceed with reclamation", "value": "approve" },
        { "label": "Reject — do not reclaim seats",      "value": "reject"  }
      ]
    },
    {
      "type": "textarea",
      "id": "ta_reviewNotes",
      "label": "Review Notes (optional)",
      "key": "reviewNotes",
      "description": "Explain your decision or list any exceptions"
    },

    {
      "type": "separator",
      "id": "sep_procurement"
    },
    {
      "type": "text",
      "id": "text_procurement_section",
      "text": "### Procurement: PO Approval"
    },
    {
      "type": "expression",
      "id": "expr_reclaimedCount",
      "label": "Licenses Reclaimed",
      "key": "reclaimedCountDisplay",
      "expression": "=if reclaimedCount != null then string(reclaimedCount) else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_jiraKey",
      "label": "Legal Ticket (Jira)",
      "key": "jiraKeyDisplay",
      "expression": "=if jiraTicket != null then jiraTicket.key else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_quoteSeats",
      "label": "Vendor Quote — Seats",
      "key": "quoteSeatDisplay",
      "expression": "=if vendorQuote != null then string(vendorQuote.seats) else \"—\"",
      "readonly": true
    },
    {
      "type": "expression",
      "id": "expr_quoteTotal",
      "label": "Vendor Quote — Total Price",
      "key": "quoteTotalDisplay",
      "expression": "=if vendorQuote != null then \"$\" + string(vendorQuote.totalPrice) + \" \" + vendorQuote.currency else \"—\"",
      "readonly": true
    },
    {
      "type": "number",
      "id": "num_finalSeats",
      "label": "Approved Seat Count",
      "key": "finalSeats",
      "description": "Enter the final number of licenses to include in the renewal PO",
      "validate": {
        "min": 1
      }
    },
    {
      "type": "select",
      "id": "select_procurementDecision",
      "label": "Procurement Decision",
      "key": "procurementDecision",
      "values": [
        { "label": "Approve — submit PO to Coupa",  "value": "approve" },
        { "label": "Reject — do not renew contract", "value": "reject"  }
      ]
    },
    {
      "type": "textarea",
      "id": "ta_procurementNotes",
      "label": "Procurement Notes (optional)",
      "key": "procurementNotes",
      "description": "Budget justification or rejection reason"
    }
  ]
}
