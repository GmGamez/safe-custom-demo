<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_LicenseRenewal"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Claude Code"
                  exporterVersion="1.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.9.0">

  <bpmn:process id="license-renewal" name="License Renewal Orchestration" isExecutable="true">

    <!-- ── Start ─────────────────────────────────────────────────────────── -->
    <bpmn:startEvent id="StartEvent_1" name="License Renewal Triggered">
      <bpmn:outgoing>Flow_StartToFork</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:sequenceFlow id="Flow_StartToFork" sourceRef="StartEvent_1" targetRef="Gateway_Fork"/>

    <!-- ── Parallel fork: fetch usage signals + vendor quote ─────────────── -->
    <bpmn:parallelGateway id="Gateway_Fork" name="Gather signals">
      <bpmn:incoming>Flow_StartToFork</bpmn:incoming>
      <bpmn:outgoing>Flow_ForkToOkta</bpmn:outgoing>
      <bpmn:outgoing>Flow_ForkToFlexera</bpmn:outgoing>
      <bpmn:outgoing>Flow_ForkToVendor</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Fetch Okta SSO usage -->
    <bpmn:sequenceFlow id="Flow_ForkToOkta" sourceRef="Gateway_Fork" targetRef="Task_FetchOkta"/>
    <bpmn:serviceTask id="Task_FetchOkta" name="Fetch Okta SSO Usage">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch_okta_usage" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ForkToOkta</bpmn:incoming>
      <bpmn:outgoing>Flow_OktaToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_OktaToJoin" sourceRef="Task_FetchOkta" targetRef="Gateway_Join"/>

    <!-- Fetch Flexera on-premise metering -->
    <bpmn:sequenceFlow id="Flow_ForkToFlexera" sourceRef="Gateway_Fork" targetRef="Task_FetchFlexera"/>
    <bpmn:serviceTask id="Task_FetchFlexera" name="Fetch Flexera Metering Data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch_flexera_usage" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ForkToFlexera</bpmn:incoming>
      <bpmn:outgoing>Flow_FlexeraToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_FlexeraToJoin" sourceRef="Task_FetchFlexera" targetRef="Gateway_Join"/>

    <!-- Fetch vendor renewal quote -->
    <bpmn:sequenceFlow id="Flow_ForkToVendor" sourceRef="Gateway_Fork" targetRef="Task_FetchVendorQuote"/>
    <bpmn:serviceTask id="Task_FetchVendorQuote" name="Fetch Vendor Renewal Quote">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch_vendor_quote" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ForkToVendor</bpmn:incoming>
      <bpmn:outgoing>Flow_VendorToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_VendorToJoin" sourceRef="Task_FetchVendorQuote" targetRef="Gateway_Join"/>

    <!-- ── Parallel join ─────────────────────────────────────────────────── -->
    <bpmn:parallelGateway id="Gateway_Join" name="Signals collected">
      <bpmn:incoming>Flow_OktaToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_FlexeraToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_VendorToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToAggregate</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- ── Aggregate & score usage signals ───────────────────────────────── -->
    <bpmn:sequenceFlow id="Flow_JoinToAggregate" sourceRef="Gateway_Join" targetRef="Task_AggregateUsage"/>
    <bpmn:serviceTask id="Task_AggregateUsage" name="Aggregate Usage Signals">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="aggregate_usage_signals" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinToAggregate</bpmn:incoming>
      <bpmn:outgoing>Flow_AggregateToScoring</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sequenceFlow id="Flow_AggregateToScoring" sourceRef="Task_AggregateUsage" targetRef="Task_UsageScoring"/>
    <bpmn:businessRuleTask id="Task_UsageScoring" name="Score License Utilization">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="license_usage_scoring" resultVariable="usageScore"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AggregateToScoring</bpmn:incoming>
      <bpmn:outgoing>Flow_ScoringToIdentify</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <!-- ── Identify reclaimable licenses ────────────────────────────────── -->
    <bpmn:sequenceFlow id="Flow_ScoringToIdentify" sourceRef="Task_UsageScoring" targetRef="Task_IdentifyReclaimable"/>
    <bpmn:serviceTask id="Task_IdentifyReclaimable" name="Identify Reclaimable Licenses">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="identify_reclaimable_licenses" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ScoringToIdentify</bpmn:incoming>
      <bpmn:outgoing>Flow_IdentifyToReview</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── App owner review ──────────────────────────────────────────────── -->
    <bpmn:sequenceFlow id="Flow_IdentifyToReview" sourceRef="Task_IdentifyReclaimable" targetRef="Task_ReviewReclamation"/>
    <bpmn:userTask id="Task_ReviewReclamation" name="App Owner: Review License Reclamation">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="license-renewal-review"/>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="=appOwner"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_IdentifyToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ReviewToGateway" sourceRef="Task_ReviewReclamation" targetRef="Gateway_ReviewDecision"/>
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Review decision?" default="Flow_ReviewApprove">
      <bpmn:incoming>Flow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Reject path: notify app owner, end -->
    <bpmn:sequenceFlow id="Flow_ReviewReject" name="Reject" sourceRef="Gateway_ReviewDecision" targetRef="Task_NotifyAppOwnerReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_NotifyAppOwnerReject" name="Notify App Owner (Rejected)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify_app_owner" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewReject</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyRejectToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NotifyRejectToEnd" sourceRef="Task_NotifyAppOwnerReject" targetRef="EndEvent_ReclamationRejected"/>
    <bpmn:endEvent id="EndEvent_ReclamationRejected" name="Reclamation Rejected">
      <bpmn:incoming>Flow_NotifyRejectToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Approve path: reclaim licenses → legal → procurement -->
    <bpmn:sequenceFlow id="Flow_ReviewApprove" name="Approve" sourceRef="Gateway_ReviewDecision" targetRef="Task_ReclaimLicenses"/>
    <bpmn:serviceTask id="Task_ReclaimLicenses" name="Reclaim Inactive Licenses">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reclaim_licenses" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ReclaimToJira</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── Legal ticket ──────────────────────────────────────────────────── -->
    <bpmn:sequenceFlow id="Flow_ReclaimToJira" sourceRef="Task_ReclaimLicenses" targetRef="Task_CreateJiraTicket"/>
    <bpmn:serviceTask id="Task_CreateJiraTicket" name="Create Jira Legal Ticket">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create_jira_legal_ticket" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReclaimToJira</bpmn:incoming>
      <bpmn:outgoing>Flow_JiraToApproval</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- ── Procurement approval ──────────────────────────────────────────── -->
    <bpmn:sequenceFlow id="Flow_JiraToApproval" sourceRef="Task_CreateJiraTicket" targetRef="Task_ProcurementApproval"/>
    <bpmn:userTask id="Task_ProcurementApproval" name="Procurement: Approve License Renewal PO">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="license-renewal-review"/>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition candidateGroups="procurement"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JiraToApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sequenceFlow id="Flow_ApprovalToGateway" sourceRef="Task_ProcurementApproval" targetRef="Gateway_ProcurementDecision"/>
    <bpmn:exclusiveGateway id="Gateway_ProcurementDecision" name="Procurement decision?" default="Flow_ProcApprove">
      <bpmn:incoming>Flow_ApprovalToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ProcApprove</bpmn:outgoing>
      <bpmn:outgoing>Flow_ProcReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Approve path: submit PO, end renewal complete -->
    <bpmn:sequenceFlow id="Flow_ProcApprove" name="Approve" sourceRef="Gateway_ProcurementDecision" targetRef="Task_SubmitCoupaPO"/>
    <bpmn:serviceTask id="Task_SubmitCoupaPO" name="Submit Coupa PO">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="submit_coupa_po" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProcApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_SubmitToEnd" sourceRef="Task_SubmitCoupaPO" targetRef="EndEvent_RenewalComplete"/>
    <bpmn:endEvent id="EndEvent_RenewalComplete" name="Renewal Complete">
      <bpmn:incoming>Flow_SubmitToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Reject path: notify app owner, end renewal cancelled -->
    <bpmn:sequenceFlow id="Flow_ProcReject" name="Reject" sourceRef="Gateway_ProcurementDecision" targetRef="Task_NotifyAppOwnerCancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=procurementDecision = "reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_NotifyAppOwnerCancel" name="Notify App Owner (Cancelled)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify_app_owner" retries="3"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ProcReject</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyCancelToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NotifyCancelToEnd" sourceRef="Task_NotifyAppOwnerCancel" targetRef="EndEvent_RenewalCancelled"/>
    <bpmn:endEvent id="EndEvent_RenewalCancelled" name="Renewal Cancelled">
      <bpmn:incoming>Flow_NotifyCancelToEnd</bpmn:incoming>
    </bpmn:endEvent>

  </bpmn:process>

  <!-- ── Diagram layout ────────────────────────────────────────────────── -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="license-renewal">

      <!-- Start -->
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="162" y="302" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="138" y="345" width="84" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Parallel fork -->
      <bpmndi:BPMNShape id="Shape_Gateway_Fork" bpmnElement="Gateway_Fork" isMarkerVisible="true">
        <dc:Bounds x="265" y="295" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="254" y="352" width="72" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Fetch Okta -->
      <bpmndi:BPMNShape id="Shape_Task_FetchOkta" bpmnElement="Task_FetchOkta">
        <dc:Bounds x="375" y="160" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Fetch Flexera -->
      <bpmndi:BPMNShape id="Shape_Task_FetchFlexera" bpmnElement="Task_FetchFlexera">
        <dc:Bounds x="375" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Fetch Vendor Quote -->
      <bpmndi:BPMNShape id="Shape_Task_FetchVendorQuote" bpmnElement="Task_FetchVendorQuote">
        <dc:Bounds x="375" y="400" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Parallel join -->
      <bpmndi:BPMNShape id="Shape_Gateway_Join" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <dc:Bounds x="555" y="295" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="538" y="352" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Aggregate Usage -->
      <bpmndi:BPMNShape id="Shape_Task_AggregateUsage" bpmnElement="Task_AggregateUsage">
        <dc:Bounds x="665" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Usage Scoring (BRT) -->
      <bpmndi:BPMNShape id="Shape_Task_UsageScoring" bpmnElement="Task_UsageScoring">
        <dc:Bounds x="845" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Identify Reclaimable -->
      <bpmndi:BPMNShape id="Shape_Task_IdentifyReclaimable" bpmnElement="Task_IdentifyReclaimable">
        <dc:Bounds x="1025" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Review Reclamation (User Task) -->
      <bpmndi:BPMNShape id="Shape_Task_ReviewReclamation" bpmnElement="Task_ReviewReclamation">
        <dc:Bounds x="1205" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Review Decision Gateway -->
      <bpmndi:BPMNShape id="Shape_Gateway_ReviewDecision" bpmnElement="Gateway_ReviewDecision" isMarkerVisible="true">
        <dc:Bounds x="1385" y="295" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1365" y="352" width="90" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Notify App Owner (Reject path) -->
      <bpmndi:BPMNShape id="Shape_Task_NotifyAppOwnerReject" bpmnElement="Task_NotifyAppOwnerReject">
        <dc:Bounds x="1485" y="160" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- End: Reclamation Rejected -->
      <bpmndi:BPMNShape id="Shape_EndEvent_ReclamationRejected" bpmnElement="EndEvent_ReclamationRejected">
        <dc:Bounds x="1667" y="182" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1645" y="225" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Reclaim Licenses -->
      <bpmndi:BPMNShape id="Shape_Task_ReclaimLicenses" bpmnElement="Task_ReclaimLicenses">
        <dc:Bounds x="1485" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Create Jira Ticket -->
      <bpmndi:BPMNShape id="Shape_Task_CreateJiraTicket" bpmnElement="Task_CreateJiraTicket">
        <dc:Bounds x="1665" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Procurement Approval (User Task) -->
      <bpmndi:BPMNShape id="Shape_Task_ProcurementApproval" bpmnElement="Task_ProcurementApproval">
        <dc:Bounds x="1845" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Procurement Decision Gateway -->
      <bpmndi:BPMNShape id="Shape_Gateway_ProcurementDecision" bpmnElement="Gateway_ProcurementDecision" isMarkerVisible="true">
        <dc:Bounds x="2025" y="295" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2000" y="352" width="100" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Submit Coupa PO -->
      <bpmndi:BPMNShape id="Shape_Task_SubmitCoupaPO" bpmnElement="Task_SubmitCoupaPO">
        <dc:Bounds x="2125" y="280" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- End: Renewal Complete -->
      <bpmndi:BPMNShape id="Shape_EndEvent_RenewalComplete" bpmnElement="EndEvent_RenewalComplete">
        <dc:Bounds x="2307" y="302" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2285" y="345" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Notify App Owner (Cancel path) -->
      <bpmndi:BPMNShape id="Shape_Task_NotifyAppOwnerCancel" bpmnElement="Task_NotifyAppOwnerCancel">
        <dc:Bounds x="2125" y="400" width="120" height="80"/>
      </bpmndi:BPMNShape>

      <!-- End: Renewal Cancelled -->
      <bpmndi:BPMNShape id="Shape_EndEvent_RenewalCancelled" bpmnElement="EndEvent_RenewalCancelled">
        <dc:Bounds x="2307" y="422" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2285" y="465" width="80" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Sequence flow edges -->
      <bpmndi:BPMNEdge id="Edge_Flow_StartToFork" bpmnElement="Flow_StartToFork">
        <di:waypoint x="198" y="320"/><di:waypoint x="265" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ForkToOkta" bpmnElement="Flow_ForkToOkta">
        <di:waypoint x="290" y="295"/><di:waypoint x="290" y="200"/><di:waypoint x="375" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ForkToFlexera" bpmnElement="Flow_ForkToFlexera">
        <di:waypoint x="315" y="320"/><di:waypoint x="375" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ForkToVendor" bpmnElement="Flow_ForkToVendor">
        <di:waypoint x="290" y="345"/><di:waypoint x="290" y="440"/><di:waypoint x="375" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_OktaToJoin" bpmnElement="Flow_OktaToJoin">
        <di:waypoint x="495" y="200"/><di:waypoint x="580" y="200"/><di:waypoint x="580" y="295"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_FlexeraToJoin" bpmnElement="Flow_FlexeraToJoin">
        <di:waypoint x="495" y="320"/><di:waypoint x="555" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_VendorToJoin" bpmnElement="Flow_VendorToJoin">
        <di:waypoint x="495" y="440"/><di:waypoint x="580" y="440"/><di:waypoint x="580" y="345"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_JoinToAggregate" bpmnElement="Flow_JoinToAggregate">
        <di:waypoint x="605" y="320"/><di:waypoint x="665" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_AggregateToScoring" bpmnElement="Flow_AggregateToScoring">
        <di:waypoint x="785" y="320"/><di:waypoint x="845" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ScoringToIdentify" bpmnElement="Flow_ScoringToIdentify">
        <di:waypoint x="965" y="320"/><di:waypoint x="1025" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_IdentifyToReview" bpmnElement="Flow_IdentifyToReview">
        <di:waypoint x="1145" y="320"/><di:waypoint x="1205" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ReviewToGateway" bpmnElement="Flow_ReviewToGateway">
        <di:waypoint x="1325" y="320"/><di:waypoint x="1385" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ReviewReject" bpmnElement="Flow_ReviewReject">
        <di:waypoint x="1410" y="295"/><di:waypoint x="1410" y="200"/><di:waypoint x="1485" y="200"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1427" y="243" width="31" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ReviewApprove" bpmnElement="Flow_ReviewApprove">
        <di:waypoint x="1435" y="320"/><di:waypoint x="1485" y="320"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1450" y="302" width="41" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_NotifyRejectToEnd" bpmnElement="Flow_NotifyRejectToEnd">
        <di:waypoint x="1605" y="200"/><di:waypoint x="1667" y="200"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ReclaimToJira" bpmnElement="Flow_ReclaimToJira">
        <di:waypoint x="1605" y="320"/><di:waypoint x="1665" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_JiraToApproval" bpmnElement="Flow_JiraToApproval">
        <di:waypoint x="1785" y="320"/><di:waypoint x="1845" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ApprovalToGateway" bpmnElement="Flow_ApprovalToGateway">
        <di:waypoint x="1965" y="320"/><di:waypoint x="2025" y="320"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ProcApprove" bpmnElement="Flow_ProcApprove">
        <di:waypoint x="2075" y="320"/><di:waypoint x="2125" y="320"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2088" y="302" width="41" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ProcReject" bpmnElement="Flow_ProcReject">
        <di:waypoint x="2050" y="345"/><di:waypoint x="2050" y="440"/><di:waypoint x="2125" y="440"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2067" y="383" width="31" height="14"/></bpmndi:BPMNLabel>
