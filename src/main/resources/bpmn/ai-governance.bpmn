<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_AiGovernance" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:escalation id="Escalation_RecertificationFailed" name="Recertification failed" escalationCode="recertification-failed" />
  <bpmn:escalation id="Escalation_ReassessmentAction" name="Reassessment action required" escalationCode="reassessment-action-required" />
  <bpmn:message id="Message_IncidentReported" name="IncidentReported">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=useCaseId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="AiGovernanceProcess" name="AI Governance Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_UseCaseSubmitted" name="AI use case submitted">
      <bpmn:outgoing>Flow_SubmittedToAssignOwners</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_SubmittedToAssignOwners" sourceRef="StartEvent_UseCaseSubmitted" targetRef="Task_AssignOwners" />
    <bpmn:userTask id="Task_AssignOwners" name="Assign accountable owners">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="assign-owners" />
        <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SubmittedToAssignOwners</bpmn:incoming>
      <bpmn:outgoing>Flow_AssignOwnersToCategory</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_AssignOwnersToCategory" sourceRef="Task_AssignOwners" targetRef="Task_DetermineAiCategory" />
    <bpmn:businessRuleTask id="Task_DetermineAiCategory" name="Determine AI category">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="AiCategoryScoring" resultVariable="categoryResult" />
        <zeebe:ioMapping>
          <zeebe:output source="=categoryResult.aiCategory" target="aiCategory" />
          <zeebe:output source="=categoryResult.requiresSecurityReview" target="requiresSecurityReview" />
          <zeebe:output source="=categoryResult.requiresPrivacyReview" target="requiresPrivacyReview" />
          <zeebe:output source="=categoryResult.requiresLegalReview" target="requiresLegalReview" />
          <zeebe:output source="=categoryResult.requiresComplianceReview" target="requiresComplianceReview" />
          <zeebe:output source="=categoryResult.requiresArchitectureReview" target="requiresArchitectureReview" />
          <zeebe:output source="=categoryResult.requiresRaiReview" target="requiresRaiReview" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AssignOwnersToCategory</bpmn:incoming>
      <bpmn:incoming>Flow_ReassessmentActionToRereview</bpmn:incoming>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_CategoryToTriageAgent" sourceRef="Task_DetermineAiCategory" targetRef="AdHocSubProcess_TriageAgent" />
    <bpmn:adHocSubProcess id="AdHocSubProcess_TriageAgent" name="AI risk triage agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="1" />
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="{{secrets.openAiApiKey}}" target="provider.openai.authentication.apiKey" />
          <zeebe:input source="gpt-5" target="provider.openai.model.model" />
          <zeebe:input source="2048" target="provider.openai.model.parameters.maxTokens" />
          <zeebe:input source="=&#34;You are an AI governance triage assistant. Before a proposed AI use case reaches human reviewers (Security, Privacy, Legal, Compliance, Architecture, Responsible AI), gather context that helps them decide faster and more consistently. Use the available tools to: (1) search internal policy documents relevant to this use case, (2) scan the use case description for sensitive data categories, and (3) find similar previously governed use cases as precedent. You never approve or reject the use case yourself — only the human reviewers do that. When you are done gathering context, respond with a concise structured summary using this format:\n\n## Risk Flags\n- ...\n\n## Relevant Policies\n- ...\n\n## Similar Precedents\n- ...\n\n## Suggested Focus Areas for Reviewers\n- ...&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Use case: &#34; + useCaseName + &#34;\n\nDescription: &#34; + description + &#34;\n\nIntended use: &#34; + intendedUse + &#34;\n\nData sensitivity: &#34; + dataSensitivity + &#34;\nAutonomy level: &#34; + autonomyLevel + &#34;\nAI category (already determined by DMN): &#34; + aiCategory" target="data.userPrompt.prompt" />
          <zeebe:input target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="6" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=false" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agent.responseText" target="triageSummary" />
          <zeebe:output source="=toolCallResults" target="triageToolCalls" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CategoryToTriageAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_TriageAgentToRouteReviews</bpmn:outgoing>
      <bpmn:serviceTask id="Tool_SearchPolicyDocs" name="Search policy documents">
        <bpmn:documentation>Searches internal governance policy documents for passages relevant to a topic or keyword.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="triage_search_policy_docs" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.query, &#34;Keywords or topic to search internal policy documents for&#34;, &#34;string&#34;)" target="query" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Tool_ScanSensitiveData" name="Scan for sensitive data patterns">
        <bpmn:documentation>Scans a piece of text for categories of sensitive data it may involve (PII, health, financial, biometric, location, minors, protected class).</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="triage_scan_sensitive_data" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.text, &#34;The use case description and intended-use text to scan for sensitive data categories&#34;, &#34;string&#34;)" target="text" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Tool_FindSimilarUseCases" name="Find similar governed use cases">
        <bpmn:documentation>Looks up previously governed AI use cases similar to this one, returning their category and outcome as precedent.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="triage_find_similar_use_cases" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.keywords, &#34;Keywords describing the use case, used to find similar previously governed precedents&#34;, &#34;string&#34;)" target="keywords" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_TriageAgentToRouteReviews" sourceRef="AdHocSubProcess_TriageAgent" targetRef="Gateway_RouteReviews" />
    <bpmn:inclusiveGateway id="Gateway_RouteReviews" name="Reviews required?">
      <bpmn:incoming>Flow_TriageAgentToRouteReviews</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteToSecurity</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteToPrivacy</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteToLegal</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteToCompliance</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteToArchitecture</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteToRai</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="Flow_RouteToSecurity" sourceRef="Gateway_RouteReviews" targetRef="Task_SecurityReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requiresSecurityReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_SecurityReview" name="Review security posture">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-decision" />
        <zeebe:assignmentDefinition candidateGroups="security-team" />
        <zeebe:ioMapping>
          <zeebe:output source="=reviewDecision" target="securityReviewDecision" />
          <zeebe:output source="=reviewComments" target="securityReviewComments" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteToSecurity</bpmn:incoming>
      <bpmn:outgoing>Flow_SecurityToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_SecurityToJoin" sourceRef="Task_SecurityReview" targetRef="Gateway_ReviewsJoin" />
    <bpmn:sequenceFlow id="Flow_RouteToPrivacy" sourceRef="Gateway_RouteReviews" targetRef="Task_PrivacyReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requiresPrivacyReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_PrivacyReview" name="Review privacy impact">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-decision" />
        <zeebe:assignmentDefinition candidateGroups="privacy-team" />
        <zeebe:ioMapping>
          <zeebe:output source="=reviewDecision" target="privacyReviewDecision" />
          <zeebe:output source="=reviewComments" target="privacyReviewComments" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteToPrivacy</bpmn:incoming>
      <bpmn:outgoing>Flow_PrivacyToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PrivacyToJoin" sourceRef="Task_PrivacyReview" targetRef="Gateway_ReviewsJoin" />
    <bpmn:sequenceFlow id="Flow_RouteToLegal" sourceRef="Gateway_RouteReviews" targetRef="Task_LegalReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requiresLegalReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_LegalReview" name="Review legal implications">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-decision" />
        <zeebe:assignmentDefinition candidateGroups="legal-team" />
        <zeebe:ioMapping>
          <zeebe:output source="=reviewDecision" target="legalReviewDecision" />
          <zeebe:output source="=reviewComments" target="legalReviewComments" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteToLegal</bpmn:incoming>
      <bpmn:outgoing>Flow_LegalToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_LegalToJoin" sourceRef="Task_LegalReview" targetRef="Gateway_ReviewsJoin" />
    <bpmn:sequenceFlow id="Flow_RouteToCompliance" sourceRef="Gateway_RouteReviews" targetRef="Task_ComplianceReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requiresComplianceReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_ComplianceReview" name="Review regulatory compliance">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-decision" />
        <zeebe:assignmentDefinition candidateGroups="compliance-team" />
        <zeebe:ioMapping>
          <zeebe:output source="=reviewDecision" target="complianceReviewDecision" />
          <zeebe:output source="=reviewComments" target="complianceReviewComments" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteToCompliance</bpmn:incoming>
      <bpmn:outgoing>Flow_ComplianceToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ComplianceToJoin" sourceRef="Task_ComplianceReview" targetRef="Gateway_ReviewsJoin" />
    <bpmn:sequenceFlow id="Flow_RouteToArchitecture" sourceRef="Gateway_RouteReviews" targetRef="Task_ArchitectureReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requiresArchitectureReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_ArchitectureReview" name="Review technical architecture">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-decision" />
        <zeebe:assignmentDefinition candidateGroups="architecture-team" />
        <zeebe:ioMapping>
          <zeebe:output source="=reviewDecision" target="architectureReviewDecision" />
          <zeebe:output source="=reviewComments" target="architectureReviewComments" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteToArchitecture</bpmn:incoming>
      <bpmn:outgoing>Flow_ArchitectureToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_ArchitectureToJoin" sourceRef="Task_ArchitectureReview" targetRef="Gateway_ReviewsJoin" />
    <bpmn:sequenceFlow id="Flow_RouteToRai" sourceRef="Gateway_RouteReviews" targetRef="Task_RaiReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_RaiReview" name="Review responsible AI alignment">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-decision" />
        <zeebe:assignmentDefinition candidateGroups="responsible-ai-office" />
        <zeebe:ioMapping>
          <zeebe:output source="=reviewDecision" target="raiReviewDecision" />
          <zeebe:output source="=reviewComments" target="raiReviewComments" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteToRai</bpmn:incoming>
      <bpmn:outgoing>Flow_RaiToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_RaiToJoin" sourceRef="Task_RaiReview" targetRef="Gateway_ReviewsJoin" />
    <bpmn:inclusiveGateway id="Gateway_ReviewsJoin">
      <bpmn:incoming>Flow_SecurityToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PrivacyToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_LegalToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_ComplianceToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_ArchitectureToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_RaiToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToReviewsApproved</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:sequenceFlow id="Flow_JoinToReviewsApproved" sourceRef="Gateway_ReviewsJoin" targetRef="Gateway_ReviewsApproved" />
    <bpmn:exclusiveGateway id="Gateway_ReviewsApproved" name="Reviews approved?" default="Flow_ReviewsApprovedNo">
      <bpmn:incoming>Flow_JoinToReviewsApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewsApprovedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReviewsApprovedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ReviewsApprovedYes" name="Yes" sourceRef="Gateway_ReviewsApproved" targetRef="Task_ModelEvaluationGate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(requiresSecurityReview = false or securityReviewDecision = "approve") and (requiresPrivacyReview = false or privacyReviewDecision = "approve") and (requiresLegalReview = false or legalReviewDecision = "approve") and (requiresComplianceReview = false or complianceReviewDecision = "approve") and (requiresArchitectureReview = false or architectureReviewDecision = "approve") and (requiresRaiReview = false or raiReviewDecision = "approve")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReviewsApprovedNo" name="No" sourceRef="Gateway_ReviewsApproved" targetRef="EndEvent_UseCaseRejectedReviews" />
    <bpmn:endEvent id="EndEvent_UseCaseRejectedReviews" name="Use case rejected — reviews">
      <bpmn:incoming>Flow_ReviewsApprovedNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ModelEvaluationGate" name="Complete model evaluation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="gate-decision" />
        <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
        <zeebe:ioMapping>
          <zeebe:output source="=gateResult" target="modelEvaluationResult" />
          <zeebe:output source="=gateNotes" target="modelEvaluationNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReviewsApprovedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_EvaluationGateToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_EvaluationGateToGateway" sourceRef="Task_ModelEvaluationGate" targetRef="Gateway_EvaluationPassed" />
    <bpmn:exclusiveGateway id="Gateway_EvaluationPassed" name="Evaluation passed?" default="Flow_EvaluationPassedNo">
      <bpmn:incoming>Flow_EvaluationGateToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_EvaluationPassedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_EvaluationPassedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_EvaluationPassedYes" name="Pass" sourceRef="Gateway_EvaluationPassed" targetRef="Task_DesignConsultationGate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=modelEvaluationResult = "pass"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EvaluationPassedNo" name="Fail" sourceRef="Gateway_EvaluationPassed" targetRef="EndEvent_UseCaseRejectedEvaluation" />
    <bpmn:endEvent id="EndEvent_UseCaseRejectedEvaluation" name="Use case rejected — evaluation">
      <bpmn:incoming>Flow_EvaluationPassedNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_DesignConsultationGate" name="Confirm design consultation">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="gate-decision" />
        <zeebe:assignmentDefinition candidateGroups="architecture-team" />
        <zeebe:ioMapping>
          <zeebe:output source="=gateResult" target="designConsultationResult" />
          <zeebe:output source="=gateNotes" target="designConsultationNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EvaluationPassedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_DesignGateToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_DesignGateToGateway" sourceRef="Task_DesignConsultationGate" targetRef="Gateway_DesignConfirmed" />
    <bpmn:exclusiveGateway id="Gateway_DesignConfirmed" name="Design confirmed?" default="Flow_DesignConfirmedNo">
      <bpmn:incoming>Flow_DesignGateToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DesignConfirmedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DesignConfirmedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_DesignConfirmedYes" name="Pass" sourceRef="Gateway_DesignConfirmed" targetRef="Task_PreBuildGate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=designConsultationResult = "pass"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DesignConfirmedNo" name="Fail" sourceRef="Gateway_DesignConfirmed" targetRef="EndEvent_UseCaseRejectedDesign" />
    <bpmn:endEvent id="EndEvent_UseCaseRejectedDesign" name="Use case rejected — design consultation">
      <bpmn:incoming>Flow_DesignConfirmedNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_PreBuildGate" name="Complete pre-build checkpoint">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="gate-decision" />
        <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
        <zeebe:ioMapping>
          <zeebe:output source="=gateResult" target="preBuildResult" />
          <zeebe:output source="=gateNotes" target="preBuildNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DesignConfirmedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_PreBuildGateToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PreBuildGateToGateway" sourceRef="Task_PreBuildGate" targetRef="Gateway_PreBuildPassed" />
    <bpmn:exclusiveGateway id="Gateway_PreBuildPassed" name="Pre-build checkpoint passed?" default="Flow_PreBuildPassedNo">
      <bpmn:incoming>Flow_PreBuildGateToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PreBuildPassedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_PreBuildPassedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PreBuildPassedYes" name="Pass" sourceRef="Gateway_PreBuildPassed" targetRef="Task_PreProductionGate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=preBuildResult = "pass"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PreBuildPassedNo" name="Fail" sourceRef="Gateway_PreBuildPassed" targetRef="EndEvent_UseCaseRejectedPreBuild" />
    <bpmn:endEvent id="EndEvent_UseCaseRejectedPreBuild" name="Use case rejected — pre-build checkpoint">
      <bpmn:incoming>Flow_PreBuildPassedNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_PreProductionGate" name="Complete pre-production checkpoint">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="gate-decision" />
        <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
        <zeebe:ioMapping>
          <zeebe:output source="=gateResult" target="preProductionResult" />
          <zeebe:output source="=gateNotes" target="preProductionNotes" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PreBuildPassedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_PreProductionGateToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_PreProductionGateToGateway" sourceRef="Task_PreProductionGate" targetRef="Gateway_PreProductionPassed" />
    <bpmn:exclusiveGateway id="Gateway_PreProductionPassed" name="Pre-production checkpoint passed?" default="Flow_PreProductionPassedNo">
      <bpmn:incoming>Flow_PreProductionGateToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PreProductionPassedYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_PreProductionPassedNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_PreProductionPassedYes" name="Pass" sourceRef="Gateway_PreProductionPassed" targetRef="Task_LaunchApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=preProductionResult = "pass"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PreProductionPassedNo" name="Fail" sourceRef="Gateway_PreProductionPassed" targetRef="EndEvent_UseCaseRejectedPreProduction" />
    <bpmn:endEvent id="EndEvent_UseCaseRejectedPreProduction" name="Use case rejected — pre-production checkpoint">
      <bpmn:incoming>Flow_PreProductionPassedNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_LaunchApproval" name="Accept launch approval and residual risk">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="launch-approval" />
        <zeebe:assignmentDefinition candidateGroups="launch-approval-board" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PreProductionPassedYes</bpmn:incoming>
      <bpmn:outgoing>Flow_LaunchApprovalToMonitoring</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_LaunchApprovalToMonitoring" sourceRef="Task_LaunchApproval" targetRef="SubProcess_ProductionMonitoring" />
    <bpmn:subProcess id="SubProcess_ProductionMonitoring" name="Production monitoring">
      <bpmn:incoming>Flow_LaunchApprovalToMonitoring</bpmn:incoming>
      <bpmn:outgoing>Flow_MonitoringToDecommission</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_MonitoringStart">
        <bpmn:outgoing>Flow_MonitoringStartToMonitorTask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_MonitoringStartToMonitorTask" sourceRef="StartEvent_MonitoringStart" targetRef="Task_MonitorInProduction" />
      <bpmn:userTask id="Task_MonitorInProduction" name="Monitor system in production">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_MonitoringStartToMonitorTask</bpmn:incoming>
        <bpmn:outgoing>Flow_MonitorTaskToMonitoringEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_MonitorTaskToMonitoringEnd" sourceRef="Task_MonitorInProduction" targetRef="EndEvent_MonitoringEndedVoluntarily" />
      <bpmn:endEvent id="EndEvent_MonitoringEndedVoluntarily" name="Monitoring ended voluntarily">
        <bpmn:incoming>Flow_MonitorTaskToMonitoringEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="BoundaryEvent_RecertificationDue" name="Recertification due" cancelActivity="false" attachedToRef="Task_MonitorInProduction">
        <bpmn:outgoing>Flow_RecertDueToReview</bpmn:outgoing>
        <bpmn:timerEventDefinition>
          <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">=recertificationCycle</bpmn:timeCycle>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_RecertDueToReview" sourceRef="BoundaryEvent_RecertificationDue" targetRef="Task_RecertificationReview" />
      <bpmn:userTask id="Task_RecertificationReview" name="Complete recertification review">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="recertification-review" />
          <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_RecertDueToReview</bpmn:incoming>
        <bpmn:outgoing>Flow_RecertReviewToGateway</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_RecertReviewToGateway" sourceRef="Task_RecertificationReview" targetRef="Gateway_RecertificationApproved" />
      <bpmn:exclusiveGateway id="Gateway_RecertificationApproved" name="Recertification approved?" default="Flow_RecertApprovedNo">
        <bpmn:incoming>Flow_RecertReviewToGateway</bpmn:incoming>
        <bpmn:outgoing>Flow_RecertApprovedYes</bpmn:outgoing>
        <bpmn:outgoing>Flow_RecertApprovedNo</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_RecertApprovedYes" name="Yes" sourceRef="Gateway_RecertificationApproved" targetRef="EndEvent_RecertificationConfirmed">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=recertificationDecision = "approve"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="EndEvent_RecertificationConfirmed" name="Recertification confirmed">
        <bpmn:incoming>Flow_RecertApprovedYes</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_RecertApprovedNo" name="No" sourceRef="Gateway_RecertificationApproved" targetRef="EndEvent_RecertificationFailedThrow" />
      <bpmn:endEvent id="EndEvent_RecertificationFailedThrow" name="Recertification failed">
        <bpmn:incoming>Flow_RecertApprovedNo</bpmn:incoming>
        <bpmn:escalationEventDefinition escalationRef="Escalation_RecertificationFailed" />
      </bpmn:endEvent>
      <bpmn:boundaryEvent id="BoundaryEvent_IncidentReported" name="Material change or incident reported" cancelActivity="false" attachedToRef="Task_MonitorInProduction">
        <bpmn:outgoing>Flow_IncidentToReassessment</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Message_IncidentReported" />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_IncidentToReassessment" sourceRef="BoundaryEvent_IncidentReported" targetRef="Task_ReassessmentReview" />
      <bpmn:userTask id="Task_ReassessmentReview" name="Complete reassessment review">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="reassessment-review" />
          <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_IncidentToReassessment</bpmn:incoming>
        <bpmn:outgoing>Flow_ReassessmentReviewToGateway</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_ReassessmentReviewToGateway" sourceRef="Task_ReassessmentReview" targetRef="Gateway_ReassessmentOutcome" />
      <bpmn:exclusiveGateway id="Gateway_ReassessmentOutcome" name="Reassessment outcome?" default="Flow_ReassessmentActionNeeded">
        <bpmn:incoming>Flow_ReassessmentReviewToGateway</bpmn:incoming>
        <bpmn:outgoing>Flow_ReassessmentNoImpact</bpmn:outgoing>
        <bpmn:outgoing>Flow_ReassessmentActionNeeded</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_ReassessmentNoImpact" name="No material impact" sourceRef="Gateway_ReassessmentOutcome" targetRef="EndEvent_ReassessmentResolved">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reassessmentOutcome = "no_material_impact"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:endEvent id="EndEvent_ReassessmentResolved" name="Reassessment resolved">
        <bpmn:incoming>Flow_ReassessmentNoImpact</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_ReassessmentActionNeeded" name="Action needed" sourceRef="Gateway_ReassessmentOutcome" targetRef="EndEvent_ReassessmentActionThrow" />
      <bpmn:endEvent id="EndEvent_ReassessmentActionThrow" name="Reassessment action required">
        <bpmn:incoming>Flow_ReassessmentActionNeeded</bpmn:incoming>
        <bpmn:escalationEventDefinition escalationRef="Escalation_ReassessmentAction" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_MonitoringToDecommission" sourceRef="SubProcess_ProductionMonitoring" targetRef="Task_Decommission" />
    <bpmn:boundaryEvent id="BoundaryEvent_RecertificationFailedCatch" name="Recertification failed" attachedToRef="SubProcess_ProductionMonitoring">
      <bpmn:outgoing>Flow_RecertFailedCatchToDecommission</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Escalation_RecertificationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_RecertFailedCatchToDecommission" sourceRef="BoundaryEvent_RecertificationFailedCatch" targetRef="Task_Decommission" />
    <bpmn:boundaryEvent id="BoundaryEvent_ReassessmentActionCatch" name="Reassessment action required" attachedToRef="SubProcess_ProductionMonitoring">
      <bpmn:outgoing>Flow_ReassessmentCatchToGateway</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Escalation_ReassessmentAction" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_ReassessmentCatchToGateway" sourceRef="BoundaryEvent_ReassessmentActionCatch" targetRef="Gateway_ReassessmentAction" />
    <bpmn:exclusiveGateway id="Gateway_ReassessmentAction" name="Reassessment requires?" default="Flow_ReassessmentGatewayToDecommission">
      <bpmn:incoming>Flow_ReassessmentCatchToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ReassessmentActionToRereview</bpmn:outgoing>
      <bpmn:outgoing>Flow_ReassessmentGatewayToDecommission</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_ReassessmentActionToRereview" name="Full re-review" sourceRef="Gateway_ReassessmentAction" targetRef="Task_DetermineAiCategory">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reassessmentOutcome = "requires_full_rereview"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReassessmentGatewayToDecommission" name="Decommission" sourceRef="Gateway_ReassessmentAction" targetRef="Task_Decommission" />
    <bpmn:userTask id="Task_Decommission" name="Decommission system and revoke access">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="decommission" />
        <zeebe:assignmentDefinition candidateGroups="ai-governance-office" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MonitoringToDecommission</bpmn:incoming>
      <bpmn:incoming>Flow_RecertFailedCatchToDecommission</bpmn:incoming>
      <bpmn:incoming>Flow_ReassessmentGatewayToDecommission</bpmn:incoming>
      <bpmn:outgoing>Flow_DecommissionToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_DecommissionToEnd" sourceRef="Task_Decommission" targetRef="EndEvent_UseCaseDecommissioned" />
    <bpmn:endEvent id="EndEvent_UseCaseDecommissioned" name="Use case decommissioned">
      <bpmn:incoming>Flow_DecommissionToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
